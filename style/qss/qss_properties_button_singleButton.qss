QPushButton[qss_properties_button_singleButton=true] {
	width: 82px;
	height: &unit_2_5&;
	border-radius: &radius_1&;
	text-align: center;
	padding: &padding_1&;
	color: &content_inverse&;
	background-color: &interactive_accent_idle&;
}

QPushButton[qss_properties_button_singleButton=true]:pressed {
	background-color: &interactive_accent_pressed&;
}
	
QPushButton[qss_properties_button_singleButton=true]:hover {
	background-color: &interactive_accent_pressed&;
}

QPushButton[qss_properties_button_singleButton=true]:checked {
	background-color: &interactive_accent_pressed&;
}

QPushButton[qss_properties_button_singleButton=true]:disabled {
	background-color: &interactive_subtle_disabled&;
}
