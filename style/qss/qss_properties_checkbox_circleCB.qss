QCheckBox[qss_properties_checkbox_circleCB="selected"] {
	width: &unit_1&;
	height: &unit_1&;
	background-color: transparent;
	color: rgba(255, 255, 255, 153);
}
QCheckBox::indicator[qss_properties_checkbox_circleCB="selected"] {
	width: 12px;
	height: 12px;
	border: 2 solid &content_default&;
	border-radius: 7px;
	image: none;
}
QCheckBox::indicator[qss_properties_checkbox_circleCB="selected"]:unchecked { 
	background-color: &background_primary&; 
}
QCheckBox[qss_properties_checkbox_circleCB="idle"] {
	width: &unit_1&;
	height: &unit_1&;
	background-color: transparent;
	color: rgba(255, 255, 255, 153);
}
QCheckBox::indicator[qss_properties_checkbox_circleCB="idle"] {
	width: 12px;
	height: 12px;
	border: 2 solid &content_default&;
	border-radius: 7px;
	image: none;
}
QCheckBox::indicator[qss_properties_checkbox_circleCB="idle"]:unchecked { 
	background-color: &background_primary&; 
}
