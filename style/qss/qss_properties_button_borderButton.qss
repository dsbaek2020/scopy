QPushButton[qss_properties_button_borderButton=true] {
    border: &border_width_interactive& solid &interactive_primary_idle&;
    border-radius: &radius_1&;
    background-color: transparent;
    color: &interactive_primary_idle&;
}
QPushButton[qss_properties_button_borderButton=true]:pressed {
    border: &border_width_interactive& solid &interactive_primary_pressed&; 
    background-color: transparent;
    color: &interactive_primary_pressed&;
}
QPushButton[qss_properties_button_borderButton=true]:hover {
    border: &border_width_interactive& solid &interactive_primary_hover&; 
    background-color: transparent;
    color: &interactive_primary_hover&;
}
QPushButton[qss_properties_button_borderButton=true]:disabled {
    border: &border_width_interactive& solid &interactive_primary_disabled&; 
    background-color: transparent;
    color: &interactive_primary_disabled&;
}
