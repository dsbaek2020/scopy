QPushButton[qss_properties_button_menuControlButton=true] {
	background-color: transparent;
}
QPushButton#btn[qss_properties_button_menuControlButton=true]:pressed {
	border-image: url(:/gui/icons/setup_btn_checked.svg)
}
QPushButton#btn[qss_properties_button_menuControlButton=true]:!pressed {
	border-image: url(:/gui/icons/&icon_theme_folder&/icons/setup_btn_unchecked.svg)
}
QPushButton#btn[qss_properties_button_menuControlButton=true]:hover:!pressed:!checked {
	border-image: url(:/gui/icons/&icon_theme_folder&/icons/setup_btn_hover.svg)
}
QPushButton#btn[qss_properties_button_menuControlButton=true]:checked {
	border-image: url(:/gui/icons/setup_btn_checked.svg);
}
