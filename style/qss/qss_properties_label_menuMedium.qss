QWidget[qss_properties_label_menuMedium=true]  {
	min-width: 50;
	font-weight: bold;
	font-size: &font_size_1&;
	text-align: left;
}
QWidget[qss_properties_label_menuMedium="selected"]  {
	color: &content_inverse&;
	min-width: 50;
	font-weight: bold;
	font-size: &font_size_1&;
	text-align: left;
}
QWidget[qss_properties_label_menuMedium="idle"]  {
	color: &content_default&;
	min-width: 50;
	font-weight: bold;
	font-size: &font_size_1&;
	text-align: left;
}
