QWidget[qss_properties_widget_customSwitchSolid="left_on"] {
    border-radius: &radius_1&;
    max-height: &unit_2&;
    min-height: &unit_2&;
    padding: 0 &padding_1& 0 &padding_1&;
    background-color: &interactive_primary_idle&;
    border: none;
    color: &content_default&;
}
QWidget[qss_properties_widget_customSwitchSolid="left_off"] {
    border-top-left-radius: &radius_1&;
    border-bottom-left-radius: &radius_1&;
    max-height: &unit_2&;
    min-height: &unit_2&;
    padding: 0 &padding_1& 0 &padding_1&;
    background-color: &background_subtle&;
    border: none;
    color: &content_silent&;
}
QWidget[qss_properties_widget_customSwitchSolid="right_on"] {
    border-radius: &radius_1&;
    max-height: &unit_2&;
    min-height: &unit_2&;
    padding: 0 &padding_1& 0 &padding_1&;
    background-color: &interactive_primary_idle&;
    border: none;
    color: &content_default&;
}
QWidget[qss_properties_widget_customSwitchSolid="right_off"] {
    border-top-right-radius: &radius_1&;
    border-bottom-right-radius: &radius_1&;
    max-height: &unit_2&;
    min-height: &unit_2&;
    padding: 0 &padding_1& 0 &padding_1&;
    background-color: &background_subtle&;
    border: none;
    color: &content_silent&;
}
