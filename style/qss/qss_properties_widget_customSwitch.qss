QWidget[qss_properties_widget_customSwitch="left_on"] {
    border-top-left-radius: &radius_1&;
    border-bottom-left-radius: &radius_1&;
    max-height: &unit_2&;
    min-height: &unit_2&;
    padding: 0 &padding_1& 0 &padding_1&;
    background-color: transparent;
    border: &border_width_interactive& solid &interactive_primary_idle&;
    color: &interactive_primary_idle&;
    font-weight:bold;
}
QWidget[qss_properties_widget_customSwitch="left_off"] {
    border-top-left-radius: &radius_1&;
    border-bottom-left-radius: &radius_1&;
    max-height: &unit_2&;
    min-height: &unit_2&;
    padding: 0 &padding_1& 0 &padding_1&;
    background-color: transparent;
    border: &border_width_interactive& solid &content_silent&;
    color: &content_silent&;
    font-weight:bold;
}
QWidget[qss_properties_widget_customSwitch="right_on"] {
    border-top-right-radius: &radius_1&;
